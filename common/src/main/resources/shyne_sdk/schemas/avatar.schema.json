{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shyne Avatar Manifest",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "enum": [
        "2.0",
        "figura"
      ],
      "default": "2.0",
      "description": "Shyne model-first Avatar standard. Missing selects the current Standard 2.0."
    },
    "import": {
      "description": "Import Figura avatars into Shyne Creator.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["figura"]
        },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["figura"] },
            "profile": { "type": "string", "enum": ["auto", "accessory", "full_body", "custom"] },
            "replace_vanilla": { "type": "boolean" }
          },
          "required": ["type"]
        }
      ]
    },
    "api": {
      "type": "string",
      "enum": [
        "auto",
        "latest",
        "2.0"
      ],
      "default": "latest",
      "description": "Shyne Lua API contract. Standard 2.0 is the only accepted version; missing, auto, and latest resolve to 2.0."
    },
    "requires": {
      "type": "object",
      "description": "Optional module requirements checked before Lua starts, for example {\"render\": \">=1.1\"}.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "profile": {
      "type": "string",
      "enum": [
        "accessory",
        "full_body",
        "custom"
      ],
      "default": "accessory",
      "description": "High-level render profile. Accessory and custom preserve the vanilla player by default; full_body replaces it."
    },
    "behavior": {
      "description": "Script-free animation behavior. A string selects a preset; an object configures controller slots and layers.",
      "oneOf": [
        {
          "type": "string",
          "enum": ["auto", "manual", "off"]
        },
        {
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "enum": ["auto", "manual", "off"],
              "default": "auto"
            },
            "autoplay": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true,
              "default": []
            },
            "animations": {
              "type": "object",
              "properties": {
                "idle": { "$ref": "#/$defs/animationNames" },
                "walk": { "$ref": "#/$defs/animationNames" },
                "sprint": { "$ref": "#/$defs/animationNames" },
                "swim": { "$ref": "#/$defs/animationNames" },
                "crouch": { "$ref": "#/$defs/animationNames" },
                "sleep": { "$ref": "#/$defs/animationNames" },
                "fly": { "$ref": "#/$defs/animationNames" },
                "sit": { "$ref": "#/$defs/animationNames" }
              },
              "additionalProperties": false
            },
            "blend_ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1200,
              "default": 5
            },
            "blink": {
              "oneOf": [
                { "type": "boolean" },
                { "type": "string" },
                {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean", "default": true },
                    "animation": { "$ref": "#/$defs/animationNames" },
                    "min_ticks": { "type": "integer", "minimum": 1, "maximum": 72000, "default": 50 },
                    "max_ticks": { "type": "integer", "minimum": 1, "maximum": 72000, "default": 110 }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ],
      "default": { "preset": "auto" }
    },
    "id": {
      "type": "string",
      "description": "Defaults to a normalized form of the Avatar folder name."
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "main": {
      "type": "string",
      "description": "Optional native Lua entry point for advanced behavior. Omit for a Zero-Lua Avatar."
    },
    "model": {
      "type": "string",
      "default": "model.bbmodel"
    },
    "online_sync": {
      "type": "boolean",
      "default": true
    },
    "replace_vanilla": {
      "type": "boolean",
      "description": "Optional override for the selected profile's vanilla-model default."
    },
    "description": {
      "type": "string"
    },
    "first_person_masking": {
      "type": "boolean",
      "description": "Optional override for the selected profile's first-person default."
    },
    "local_camera": {
      "type": "boolean",
      "description": "Optional override for the selected profile's camera default."
    },
    "texture_sync_mode": {
      "type": "string",
      "enum": [
        "metadata",
        "manifest",
        "strict"
      ],
      "default": "manifest"
    },
    "textures": {
      "type": "array",
      "description": "Texture files used by model.bbmodel. Face-to-texture mapping remains inside the model.",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "synced_schema": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "description": "Public Avatar capabilities requested from the user. Undeclared capabilities are denied.",
      "items": {
        "type": "string",
        "enum": [
          "particle",
          "sound",
          "camera",
          "microphone",
          "command",
          "hud_render",
          "world_render"
        ]
      },
      "uniqueItems": true,
      "default": []
    }
  },
  "$defs": {
    "animationNames": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    }
  }
}
