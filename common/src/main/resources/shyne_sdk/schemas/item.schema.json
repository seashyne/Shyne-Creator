{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shynecore.dev/schemas/item.schema.json",
  "title": "Shyne Creator custom item",
  "type": "object",
  "required": ["item_id", "display_name"],
  "properties": {
    "item_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "maxItems": 16 }
      ]
    },
    "icon": {
      "type": "string",
      "description": "The id of a png_icon declared in the containing shyne-package.json.",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "model": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$", "default": "shyne_creator:artifact" },
    "presentation": {
      "type": "object",
      "description": "Optional synced Blockbench presentation. The model_id is the pack folder plus .bbmodel filename, for example my_pack:crystal_staff.",
      "properties": {
        "model_id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_.-]+$" },
        "scale": { "type": "number", "minimum": 0.02, "maximum": 8, "default": 1 },
        "offset_x": { "type": "number", "default": 0 },
        "offset_y": { "type": "number", "default": 0 },
        "offset_z": { "type": "number", "default": 0 },
        "rotation_x": { "type": "number", "default": 0 },
        "rotation_y": { "type": "number", "default": 0 },
        "rotation_z": { "type": "number", "default": 0 },
        "replace_vanilla": { "type": "boolean", "default": true }
      },
      "required": ["model_id"],
      "additionalProperties": false
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "epic"],
      "default": "common",
      "description": "Optional Minecraft item styling only. It does not control whether the item can be created or used."
    },
    "max_stack": { "type": "integer", "minimum": 1, "maximum": 64, "default": 1 },
    "glint": { "type": "boolean", "default": false },
    "use_skill": { "type": "string", "default": "" },
    "weapon_id": { "type": "string", "default": "" },
    "cooldown_ticks": { "type": "integer", "minimum": 0, "maximum": 72000, "default": 0 },
    "consume_on_use": { "type": "boolean", "default": false },
    "payload": { "type": "object", "default": {} }
  },
  "additionalProperties": false
}
